# ==============================================================================
# BIERLOG - OPTIONEEL VOORBEELDBESTAND (.env.example)
#
# GOED NIEUWS: JE HOEFT HIER HELEMAAL NIETS IN TE VULLEN!
# - Bij `docker compose up -d --build` werkt alles (inclusief de eigen
#   PostgreSQL database én Google Login) 100% automatisch zonder `.env` bestand.
# - Mocht je ooit wél een lokaal `.env` bestand maken op je eigen server,
#   dan zorgt `.gitignore` ervoor dat `.env` NOOIT in je GitHub-repo komt!
# ==============================================================================

# Alleen invullen als je zelf standaardwaarden wilt overschrijven op je server:
# PORT=3000
# ADMIN_EMAIL="beheerder@voorbeeld.nl"
# SESSION_SECRET="automatisch_gegenereerd_indien_leeg"
# DATABASE_URL="postgresql://bierlog:bierlog_secret_password@bierlog-db:5432/bierlog_db"
# VITE_USE_FIRESTORE="false"

